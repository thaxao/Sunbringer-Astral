# Maintainer: thaxao <https://github.com/thaxao>
#
# The launcher lives in /opt/sunbringer-astral; each user's settings, caches,
# Custom server and mods go to ~/.local/share/sunbringer-astral (the PACKAGED
# file tells the launcher so, and turns its own updater off: pacman updates
# it).  tools/aur-update in the repository bumps pkgver and the checksum.

pkgname=sunbringer-astral-bin
_pkgname=sunbringer-astral
pkgver=1.5.2.b3.4.1
_ver=1.5.2.b3.4.1
_tag=v1.5.b3.4.1
pkgrel=1
pkgdesc="Launcher for Zenless Zone Zero private servers: servers, account editor, mods"
arch=('x86_64')
url="https://github.com/thaxao/Sunbringer-Astral"
license=('Apache-2.0')
depends=('gtk3' 'webkit2gtk-4.1' 'glib2' 'glibc' 'bash' 'curl' 'unzip')
optdepends=('wine: start the game on Linux'
            'git: the Official server and the Official client patch')
provides=("$_pkgname")
conflicts=("$_pkgname" "$_pkgname-git")
options=('!strip' '!debug')
install=sunbringer-astral-bin.install
source=("$_pkgname-$_ver-linux-x86_64.zip::$url/releases/download/$_tag/$_pkgname-$_ver-linux-x86_64.zip")
sha256sums=('54f4e6fb11c54cd9cdb5c78ee8ea17e8752bf312ce597c39c05e0b6ecf95cfd9')

package() {
  cd "$_pkgname-$_ver-linux-x86_64"

  install -d "$pkgdir/opt/$_pkgname"
  cp -r --no-preserve=ownership . "$pkgdir/opt/$_pkgname/"
  # The curl installers and their file list belong to the other way of
  # installing; pacman keeps its own.
  rm -f "$pkgdir/opt/$_pkgname"/tools/{install,uninstall}.{sh,ps1,cmd} "$pkgdir/opt/$_pkgname/MANIFEST"
  echo pacman >"$pkgdir/opt/$_pkgname/PACKAGED"
  chmod 755 "$pkgdir/opt/$_pkgname/$_pkgname" "$pkgdir/opt/$_pkgname"/tools/*

  install -d "$pkgdir/usr/bin"
  ln -s "/opt/$_pkgname/$_pkgname" "$pkgdir/usr/bin/$_pkgname"

  install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.thaxao.SunbringerAstral.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/io.github.thaxao.SunbringerAstral.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Sunbringer Astral
GenericName=Zenless Zone Zero Launcher
Comment=Zenless Zone Zero private server launcher
Exec=$_pkgname
Icon=io.github.thaxao.SunbringerAstral
Terminal=false
Categories=Game;RolePlaying;ActionGame;
Keywords=game;zenless;zzz;sunbringer;astral;server;launcher;
StartupWMClass=io.github.thaxao.SunbringerAstral
StartupNotify=true
DESKTOP
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
